# syntax=docker/dockerfile:1.7

FROM oven/bun:1.3.5 AS web
WORKDIR /web
COPY apps/web/package.json apps/web/bun.lock* ./
RUN bun install --frozen-lockfile
COPY apps/web/ ./
RUN bun run build

FROM nvidia/cuda:13.2.0-cudnn-devel-ubuntu24.04 AS build
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      cmake ninja-build build-essential pkg-config git curl ca-certificates \
      libcurl4-openssl-dev libssl-dev \
      libavcodec-dev libavformat-dev libavutil-dev libswscale-dev \
      libstdc++-14-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . /src
RUN --mount=type=cache,target=/root/.cache/ninfer-cmake-sm89 \
    --mount=type=cache,target=/root/.cache/ninfer-build-sm89 \
    set -eux; \
    cfg=/root/.cache/ninfer-cmake-sm89; \
    out=/root/.cache/ninfer-build-sm89; \
    cmake -S /src -B "$cfg" -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES=89 \
      -DNINFER_BUILD_QWEN3_8_27B=ON \
      -DNINFER_BUILD_QWEN3_6_35B_A3B=OFF \
      -DNINFER_CUDA_HEAVY_COMPILE_POOL=4 \
      -DNINFER_CUDA_LIGHT_COMPILE_POOL=1 \
      -DNINFER_CUDA_PTXAS_POOL=4 \
      -DNINFER_BUILD_TESTS=ON; \
    cmake --build "$cfg" --parallel 1 --target ninfer ninfer-serve; \
    rm -rf "$out"; mkdir -p "$out/apps"; \
    cp "$cfg/apps/ninfer" "$out/apps/ninfer"; \
    cp "$cfg/apps/ninfer-serve" "$out/apps/ninfer-serve"; \
    test -x "$out/apps/ninfer"; \
    test -x "$out/apps/ninfer-serve"

FROM nvidia/cuda:13.2.0-cudnn-runtime-ubuntu24.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl libcurl4t64 libssl3t64 \
      libavcodec61 libavformat61 libavutil59 libswscale8 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /root/.cache/ninfer-build-sm89/apps/ninfer /usr/local/bin/ninfer
COPY --from=build /root/.cache/ninfer-build-sm89/apps/ninfer-serve /usr/local/bin/ninfer-serve
COPY --from=web /web/dist /opt/ninfer/web
RUN mkdir -p /opt/ninfer/models
LABEL org.opencontainers.image.source="https://github.com/tensorninja/ninfer-4090" \
      org.opencontainers.image.revision="c55dcf359730c0d2e6c310f670966c25cf67870b" \
      io.shadowbloom.g10.model-contract="read-only host mount at /opt/ninfer/models/qwen3_8_27b.ninfer"
WORKDIR /opt/ninfer
EXPOSE 8080
CMD ["ninfer-serve", "/opt/ninfer/models/qwen3_8_27b.ninfer", "--host", "0.0.0.0", "--port", "8080", "--web-dir", "/opt/ninfer/web"]
